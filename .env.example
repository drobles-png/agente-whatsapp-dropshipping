# Copia este archivo como .env y llena los valores.

# --- Claude (IA) ---
# Clave de https://console.anthropic.com/ (Settings > API Keys)
ANTHROPIC_API_KEY=
# Modelo y esfuerzo de razonamiento (low | medium | high). medium es buen balance para ventas.
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_ESFUERZO=medium

# --- WhatsApp Cloud API (Meta for Developers) ---
# Token de acceso (temporal de 24 h para pruebas, o permanente de un usuario del sistema)
WHATSAPP_TOKEN=
# "Identificador de número de teléfono" (Phone number ID), NO el número en sí
WHATSAPP_PHONE_NUMBER_ID=
# Palabra secreta que tú inventas y pegas también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=pon-aqui-una-frase-secreta
# Clave secreta de la app (Configuración de la app > Básica). Sirve para verificar que los mensajes vienen de Meta.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# --- Tú (el dueño) ---
# Tu WhatsApp personal con código de país y sin "+" (ej. 593991234567).
# Aquí te llegan los pedidos nuevos, novedades y los chats que el agente te pasa.
DUENO_WHATSAPP=

# --- Dropi ---
# manual  = el agente guarda el pedido y te avisa con los datos listos para subirlo a Dropi.
# api     = el agente crea la orden en Dropi con el token de integración (ver README).
DROPI_MODO=manual
DROPI_API_URL=
DROPI_TOKEN=

# --- Servidor ---
PORT=3000
# Horas sin mensajes tras las que una conversación empieza de cero (los pedidos se conservan)
SESION_HORAS=72
